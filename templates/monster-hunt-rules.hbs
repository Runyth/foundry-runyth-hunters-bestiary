<form class="hb-editor-form hb-hunt-rules-form">
  <header><h1>{{localize "HB.HuntRules.OverrideTitle"}}</h1><p>{{monsterName}} · {{monsterId}}</p></header>
  <section class="hb-rules-section"><div class="hb-form-grid"><label>{{localize "HB.HuntRules.MinimumForMonster"}}<select name="minimumHuntLevel">{{#each minimumLevelOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label><label>{{localize "HB.Difficulty.OverrideTier"}}<select name="difficultyTier">{{#each difficultyTierOptions}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select></label></div></section>
  <section class="hb-rules-section"><h2>{{localize "HB.HuntRules.FieldworkOverrides"}}</h2><p>{{localize "HB.HuntRules.FieldworkOverridesHint"}}</p><div class="hb-form-grid">
    <label>{{localize "HB.HuntRules.TrackMinRumors"}}<input type="number" min="0" max="9999" name="fieldwork.trackSearch.minRumors" value="{{fieldworkOverride.trackMinRumors}}" placeholder="{{fieldworkGlobal.trackSearch.minRumors}}"></label>
    <label>{{localize "HB.HuntRules.SightingMinTracks"}}<input type="number" min="0" max="9999" name="fieldwork.sighting.minSuccessfulTracks" value="{{fieldworkOverride.sightingMinTracks}}" placeholder="{{fieldworkGlobal.sighting.minSuccessfulTracks}}"></label>
    <label>{{localize "HB.HuntRules.SightingChance"}}<input type="number" min="0" max="100" name="fieldwork.sighting.chance" value="{{fieldworkOverride.sightingChance}}" placeholder="{{fieldworkGlobal.sighting.chance}}"></label>
    <label>{{localize "HB.HuntRules.SightingApproval"}}<select name="fieldwork.sighting.gmApproval"><option value="inherit" {{#if fieldworkOverride.sightingApproval.inherit}}selected{{/if}}>{{localize "HB.HuntRules.Inherit"}}</option><option value="yes" {{#if fieldworkOverride.sightingApproval.yes}}selected{{/if}}>{{localize "HB.Common.Yes"}}</option><option value="no" {{#if fieldworkOverride.sightingApproval.no}}selected{{/if}}>{{localize "HB.Common.No"}}</option></select></label>
    <label>{{localize "HB.HuntRules.DifficultyMinSightings"}}<input type="number" min="0" max="9999" name="fieldwork.difficulty.minSightings" value="{{fieldworkOverride.difficultyMinSightings}}" placeholder="{{fieldworkGlobal.difficulty.minSightings}}"></label>
    <label>{{localize "HB.HuntRules.DifficultyChance"}}<input type="number" min="0" max="100" name="fieldwork.difficulty.chance" value="{{fieldworkOverride.difficultyChance}}" placeholder="{{fieldworkGlobal.difficulty.chance}}"></label>
    <label>{{localize "HB.HuntRules.DifficultyApproval"}}<select name="fieldwork.difficulty.gmApproval"><option value="inherit" {{#if fieldworkOverride.difficultyApproval.inherit}}selected{{/if}}>{{localize "HB.HuntRules.Inherit"}}</option><option value="yes" {{#if fieldworkOverride.difficultyApproval.yes}}selected{{/if}}>{{localize "HB.Common.Yes"}}</option><option value="no" {{#if fieldworkOverride.difficultyApproval.no}}selected{{/if}}>{{localize "HB.Common.No"}}</option></select></label>
    <label>{{localize "HB.HuntRules.RequireDifficulty"}}<select name="fieldwork.huntStart.requireDifficulty"><option value="inherit" {{#if fieldworkOverride.requireDifficulty.inherit}}selected{{/if}}>{{localize "HB.HuntRules.Inherit"}}</option><option value="yes" {{#if fieldworkOverride.requireDifficulty.yes}}selected{{/if}}>{{localize "HB.Common.Yes"}}</option><option value="no" {{#if fieldworkOverride.requireDifficulty.no}}selected{{/if}}>{{localize "HB.Common.No"}}</option></select></label>
  </div></section>
  <section class="hb-rules-section"><h2>{{localize "HB.HuntRules.DisclosureOverrides"}}</h2><p>{{localize "HB.HuntRules.DisclosureOverridesHint"}}</p>
    <div class="hb-rules-table-wrap"><table class="hb-rules-table"><thead><tr><th>{{localize "HB.Common.Field"}}</th><th>{{localize "HB.HuntRules.MinLevel"}}</th><th>{{localize "HB.HuntRules.MinPoints"}}</th><th>{{localize "HB.HuntRules.MinRumors"}}</th><th>{{localize "HB.HuntRules.Chance"}}</th><th>{{localize "HB.HuntRules.GMApproval"}}</th></tr></thead><tbody>
      {{#each rows}}<tr><th>{{label}}<small>{{globalSummary}}</small></th><td><input type="number" min="0" max="5" name="disclosure.{{field}}.minLevel" value="{{minLevel}}" placeholder="—"></td><td><input type="number" min="0" max="9999" name="disclosure.{{field}}.minPoints" value="{{minPoints}}" placeholder="—"></td><td><input type="number" min="0" max="9999" name="disclosure.{{field}}.minRumors" value="{{minRumors}}" placeholder="—"></td><td><input type="number" min="0" max="100" name="disclosure.{{field}}.chance" value="{{chance}}" placeholder="—"></td><td><select name="disclosure.{{field}}.gmApproval"><option value="inherit" {{#if approvalInherit}}selected{{/if}}>{{localize "HB.HuntRules.Inherit"}}</option><option value="yes" {{#if approvalYes}}selected{{/if}}>{{localize "HB.Common.Yes"}}</option><option value="no" {{#if approvalNo}}selected{{/if}}>{{localize "HB.Common.No"}}</option></select></td></tr>{{/each}}
    </tbody></table></div>
  </section>
  <footer class="hb-form-actions"><button type="button" data-action="close">{{localize "HB.Common.Close"}}</button><button type="button" class="danger" data-action="resetOverride">{{localize "HB.HuntRules.ResetOverride"}}</button><button type="button" class="primary" data-action="saveOverride"><i class="fa-solid fa-floppy-disk"></i> {{localize "HB.Common.Save"}}</button></footer>
</form>
